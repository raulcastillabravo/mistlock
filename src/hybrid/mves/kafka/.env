# Kafka broker
KAFKA_HOST=127.0.0.1
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# Kafka UI
KAFKA_UI_PORT=8080

# Application
KAFKA_TOPIC=trips
KAFKA_RETRY_TOPIC=trips.retry
KAFKA_DLQ_TOPIC=trips.dlq
KAFKA_GROUP_ID=trips-consumer
TRIP_STORE_PATH=db.sqlite3

# Retries: attempts before the DLQ and backoff of the first one (it doubles)
MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2

# Simulated pricing service: share of calls that fail for a moment, and a
# bug that charges 100 times the right fare
PRICING_FAILURE_RATE=0
PRICING_BUG=false

# Producer throughput (unset keeps the client default)
# KAFKA_LINGER_MS=50
# KAFKA_COMPRESSION_TYPE=lz4
