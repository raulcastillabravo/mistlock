# Kafka broker
KAFKA_HOST=127.0.0.1
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# Kafka UI
KAFKA_UI_PORT=8080

# Application
KAFKA_TOPIC=trips
KAFKA_GROUP_ID=trips-consumer

# Trip schemas: schemas/trip_v<N>.avsc. The app writes and reads trips with
# the current version; tests check it against every earlier one.
SCHEMA_DIR=schemas
TRIP_SCHEMA_VERSION=1
