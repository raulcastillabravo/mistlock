# Kafka broker
KAFKA_HOST=127.0.0.1
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# Kafka UI
KAFKA_UI_PORT=8080

# Application
KAFKA_TOPIC=user-events
KAFKA_GROUP_ID=user-events-consumer

# Consumer liveness: a killed consumer frees its partitions after the
# session timeout (6000 is the broker minimum, Kafka default is 45000)
KAFKA_SESSION_TIMEOUT_MS=6000
KAFKA_HEARTBEAT_INTERVAL_MS=2000
