# Kafka cluster (3 nodes, each one is broker and controller)
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_HOST=127.0.0.1
KAFKA_1_PORT=9092
KAFKA_2_PORT=9192
KAFKA_3_PORT=9292
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092,127.0.0.1:9192,127.0.0.1:9292

# Kafka UI
KAFKA_UI_PORT=8080

# Application
KAFKA_TOPIC=user-events
KAFKA_GROUP_ID=user-events-consumer

# Producer reliability (unset keeps the client default)
# KAFKA_ACKS=all
# KAFKA_ENABLE_IDEMPOTENCE=true
# KAFKA_LINGER_MS=5
# KAFKA_COMPRESSION_TYPE=lz4
# KAFKA_MESSAGE_TIMEOUT_MS=10000
# KAFKA_RETRIES=0
