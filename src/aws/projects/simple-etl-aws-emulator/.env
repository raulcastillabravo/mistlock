# AWS Emulator connection (files rewritten by the emulator on every start)
AWS_ENDPOINT_URL=https://127.0.0.1:9297
AWS_SHARED_CREDENTIALS_FILE=.aws/emulator/9297/emulator_credentials
AWS_CONFIG_FILE=.aws/emulator/9297/config
AWS_CA_BUNDLE=.aws/emulator/9297/ca.pem
AWS_EC2_METADATA_DISABLED=true
AWS_DISABLE_HOST_PREFIX_INJECTION=true
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_PAGER=

# Pipeline resources
BUCKET_NAME=file-uploads-bucket
DYNAMODB_TABLE_NAME=file-logs
FUNCTION_NAME=s3-file-processor
ROLE_NAME=lambda-s3-processor-role

# Deployment
LAMBDA_ZIP=deploy/dist/function.zip
CODE_BUCKET_NAME=lambda-code-bucket
STACK_NAME=simple-etl-aws-emulator
